# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or real credentials to version control.

# ── Server-side only (set in Vercel Environment Variables) ──

# Claude API (Anthropic) — used by api/generate-report.js
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase — used by api/submit-lead.js for server-side lead inserts
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Upstash Redis — rate limiting for API endpoints
# Get these from https://console.upstash.com after creating a Redis database
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Optional: restrict API endpoints to your production domain
ALLOWED_ORIGIN=https://report.awenenergy.com

# ── Client-side (VITE_ prefix = embedded in browser bundle) ──

# Supabase anon key — safe to expose (protected by RLS)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_KEY=your_anon_key_here
