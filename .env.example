# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or real credentials to version control.

# Claude API (Anthropic) — used server-side only via api/generate-report.js
# Set this in Vercel Environment Variables (NOT prefixed with VITE_)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: restrict API endpoint to your production domain
# ALLOWED_ORIGIN=https://report.awenenergy.com

# Supabase — used for lead capture storage (client-side, protected by RLS)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_KEY=your_anon_key_here
