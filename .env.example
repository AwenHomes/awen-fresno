# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or real credentials to version control.

# Claude API (Anthropic) — used to generate personalized AI reports
# TODO: Before production, move this to a Vercel serverless function (api/generate-report.js)
# so the key is not exposed in the browser bundle. See api/generate-report.js for structure.
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase — used for lead capture storage
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_KEY=your_anon_key_here
